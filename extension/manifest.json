{
    "manifest_version":  3,
    "name":  "FastDL Bridge",
    "version":  "0.5.0",
    "description":  "把浏览器下载交给本地 FastDL 引擎",
    "permissions":  [
                        "downloads",
                        "sidePanel",
                        "notifications",
                        "nativeMessaging"
                    ],
    "host_permissions":  [
                             "http://127.0.0.1:6800/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "action":  {
                   "default_title":  "FastDL 任务面板"
               },
    "side_panel":  {
                       "default_path":  "popup.html"
                   },
    "icons":  {
                  "16":  "icon16.png",
                  "48":  "icon48.png",
                  "128":  "icon128.png"
              },
    "key":  ""
}